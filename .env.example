# --- Deploy ---
# Версия образа из GHCR (тег релиза без 'v'); локально/для dev можно не задавать
TAG=latest
APP_ENV=development

SESSION_SECRET=change-me-to-a-long-random-string

# --- OAuth ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

VK_CLIENT_ID=
VK_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

OAUTH_REDIRECT_BASE=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# --- Дополнительно ---
# Явный список origin для CORS (через запятую); по умолчанию — origin из FRONTEND_URL
#ALLOWED_ORIGINS=https://anitaqlet.example.com
# Secure-cookie; пусто = авто (true, если FRONTEND_URL https)
#COOKIE_SECURE=true
#LOG_LEVEL=info

# LibreTranslate (URL пуст = автоперевод выключен, ручной ввод)
#LIBRETRANSLATE_URL=http://libretranslate:5000
#LIBRETRANSLATE_API_KEY=

# ЮKassa (пусто = платежи выключены)
#YOOKASSA_SHOP_ID=
#YOOKASSA_SECRET_KEY=
#YOOKASSA_RETURN_URL=https://anitaqlet.example.com/?paid=1
#PREMIUM_PRICE_RUB=99
